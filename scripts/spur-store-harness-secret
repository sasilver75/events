#!/usr/bin/env bash
# Store Spur harness secrets without putting token values in shell history.

set -euo pipefail

KEYCHAIN="${SPUR_HARNESS_KEYCHAIN:-$HOME/Library/Keychains/login.keychain-db}"
ENV_FILE="${SPUR_HARNESS_ENV_FILE:-$HOME/.spur/env}"

usage() {
  cat <<'EOF'
Usage:
  scripts/spur-store-harness-secret [--keychain|--env-file] linear
  scripts/spur-store-harness-secret [--keychain|--env-file] github
  scripts/spur-store-harness-secret --help

Stores:
  linear -> Keychain item spur-linear-api-key
  github -> Keychain item spur-harness-github-token
  --env-file writes exports to ~/.spur/env instead

Uses:
  SPUR_HARNESS_KEYCHAIN, when set, otherwise ~/Library/Keychains/login.keychain-db
  SPUR_HARNESS_ENV_FILE, when set, otherwise ~/.spur/env
EOF
}

mode="keychain"
case "${1:-}" in
  --keychain)
    mode="keychain"
    shift
    ;;
  --env-file)
    mode="env_file"
    shift
    ;;
esac

if [ $# -ne 1 ]; then
  usage
  exit 1
fi

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  linear)
    service="spur-linear-api-key"
    env_name="LINEAR_API_KEY"
    label="Linear API key"
    prefix="lin_api_"
    ;;
  github)
    service="spur-harness-github-token"
    env_name="SPUR_HARNESS_GITHUB_TOKEN"
    label="GitHub fine-grained PAT"
    prefix="github_pat_"
    ;;
  *)
    echo "unknown secret kind: $1" >&2
    usage
    exit 1
    ;;
esac

printf "Paste %s: " "$label" >&2
IFS= read -r -s secret
printf "\n" >&2

if [ -z "$secret" ]; then
  echo "empty secret; nothing stored" >&2
  exit 1
fi

case "$secret" in
  "$prefix"*) ;;
  *)
    echo "secret does not look like a $label (expected prefix $prefix)" >&2
    exit 1
    ;;
esac

store_keychain() {
  if ! command -v security >/dev/null; then
    echo "security command not found (this script targets macOS Keychain)" >&2
    exit 1
  fi

  security add-generic-password \
    -a "$USER" \
    -s "$service" \
    -w "$secret" \
    -U \
    "$KEYCHAIN"

  if ! security find-generic-password -a "$USER" -s "$service" -w "$KEYCHAIN" >/dev/null; then
    echo "stored item could not be verified in $KEYCHAIN" >&2
    exit 1
  fi

  echo "Stored $label in Keychain item $service."
}

store_env_file() {
  local dir tmp
  dir="$(dirname "$ENV_FILE")"
  mkdir -p "$dir"
  chmod 700 "$dir"
  tmp="$(mktemp "$dir/.env.tmp.XXXXXX")"
  if [ -f "$ENV_FILE" ]; then
    grep -v -E "^(export[[:space:]]+)?${env_name}=" "$ENV_FILE" > "$tmp" || true
  fi
  printf 'export %s=%q\n' "$env_name" "$secret" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  echo "Stored $label in $ENV_FILE as $env_name."
}

case "$mode" in
  keychain) store_keychain ;;
  env_file) store_env_file ;;
esac
