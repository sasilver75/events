{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/claude-format.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(swift-format lint *)",
      "Bash(supabase status)",
      "Bash(supabase status *)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(xcrun simctl list *)",
      "Bash(xcodebuild -showBuildSettings *)",
      "Bash(gh label list *)",
      "Bash(./scripts/spur-up.sh*)",
      "Bash(./scripts/spur-down.sh*)",
      "Bash(./scripts/spur-services-init.sh*)",
      "Bash(./scripts/spur-sim-set-location.sh*)",
      "Bash(psql -h 127.0.0.1 *)",
      "Bash(psql -h localhost *)",
      "Bash(PGPASSWORD=postgres psql -h 127.0.0.1 *)",
      "Bash(PGPASSWORD=postgres psql -h localhost *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint *)",
      "Bash(git fetch*)",
      "Bash(make migrate-up*)",
      "Bash(make migrate-down*)",
      "Bash(make seed*)",
      "Bash(make -C server migrate-up*)",
      "Bash(make -C server migrate-down*)",
      "Bash(make -C server seed*)",
      "mcp__XcodeBuildMCP__screenshot",
      "mcp__XcodeBuildMCP__session_show_defaults",
      "mcp__XcodeBuildMCP__snapshot_ui",
      "mcp__XcodeBuildMCP__tap",
      "mcp__XcodeBuildMCP__type_text",
      "mcp__XcodeBuildMCP__swipe",
      "mcp__XcodeBuildMCP__button",
      "mcp__XcodeBuildMCP__key_press",
      "mcp__XcodeBuildMCP__key_sequence",
      "mcp__XcodeBuildMCP__long_press",
      "mcp__XcodeBuildMCP__stop_app_sim",
      "mcp__XcodeBuildMCP__launch_app_logs_sim",
      "mcp__XcodeBuildMCP__list_sims",
      "mcp__XcodeBuildMCP__list_schemes",
      "mcp__XcodeBuildMCP__discover_projs",
      "mcp__XcodeBuildMCP__show_build_settings",
      "mcp__XcodeBuildMCP__session_set_defaults",
      "mcp__XcodeBuildMCP__build_sim",
      "mcp__XcodeBuildMCP__build_run_sim",
      "mcp__XcodeBuildMCP__test_sim",
      "mcp__XcodeBuildMCP__boot_sim",
      "mcp__XcodeBuildMCP__open_sim",
      "mcp__XcodeBuildMCP__install_app_sim",
      "mcp__XcodeBuildMCP__launch_app_sim",
      "mcp__XcodeBuildMCP__set_sim_location",
      "mcp__XcodeBuildMCP__reset_sim_location",
      "mcp__XcodeBuildMCP__sim_statusbar",
      "mcp__XcodeBuildMCP__set_sim_appearance",
      "mcp__XcodeBuildMCP__start_sim_log_cap",
      "mcp__XcodeBuildMCP__stop_sim_log_cap"
    ]
  }
}
