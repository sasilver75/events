{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spur-tiles",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "r2_buckets": [
    {
      "bucket_name": "spur-tiles",
      "binding": "SPUR_TILES"
    }
  ],
  "vars": {
    "PMTILES_KEY": "base/california-20260504.pmtiles"
  },
  "observability": {
    "enabled": true
  }
}
