# Spur Go server — example environment variables for LOCAL development.
#
# Copy to `server/.env` and fill in. `.env` is gitignored.
#
# Hosted envs (staging, eventually prod) do not read from `.env`. Runtime
# secrets live in the deploy platform's secret store (Fly/Railway).
#
# iOS does not read this file — Supabase config is baked into the iOS build
# at compile time (Info.plist / xcconfig). See ios/README.md when iOS
# work begins.
#
# For local values, run `supabase start` from the repo root and copy the
# printed credentials, or run `supabase status` later to re-print them.


# Postgres connection string. Local CLI default below. In hosted envs this
# points at the Supabase pooler URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL. Local CLI default below.
SUPABASE_URL=http://127.0.0.1:54321

# Anon key — safe to expose to clients.
# `supabase status` prints this as the "Publishable" key (sb_publishable_…).
SUPABASE_ANON_KEY=

# Service-role key — server-only, bypasses RLS. NEVER ship to a client.
# `supabase status` prints this as the "Secret" key (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=

# HTTP port the Go server listens on.
PORT=8080
